# Yahoo Fantasy API Credentials
# Copy this file to .env and fill in your actual credentials

YAHOO_CLIENT_KEY=your_client_key_here
YAHOO_CLIENT_SECRET=your_client_secret_here
YAHOO_APP_ID=your_app_id_here

# Database. Local scripts default to the local dev DB (same as web/.env).
# Keep this line first: comprehensive_data_extractor.py takes the first match.
DATABASE_URL=postgres://username@localhost:5432/the_league

# Neon prod (same as web/.env.production.local). Nothing reads this by default;
# pass it explicitly for a deliberate prod run. The GitHub pipeline uses the
# DATABASE_URL repo secret instead of this file.
NEON_PROD_DATABASE_URL=postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=require

# Instructions:
# 1. Go to https://developer.yahoo.com/apps/
# 2. Create a new app or use an existing one
# 3. Set redirect URI to "oob" (out of band)
# 4. Copy your Client ID as YAHOO_CLIENT_KEY
# 5. Copy your Client Secret as YAHOO_CLIENT_SECRET
# 6. Copy your App ID as YAHOO_APP_ID (optional) 