# OAuth tokens and credentials - NEVER COMMIT THESE
oauth_token.json
oauth2.json
**/oauth2.json
secrets.json
tokens.json
temp_oauth.json
*.token
*.oauth
*secret*
*token*

# ...but never let those globs swallow source code. `*token*` matched
# web/src/lib/server/login-token.ts and silently kept the entire magic-link
# implementation out of the repository — three tracked files import it, so a
# clean checkout could not build, while everything worked locally.
!**/*.ts
!**/*.svelte
!**/*.js
!**/*.sh

# Configuration files with secrets - NEVER COMMIT THESE
config.json
**/config.json

# Logs - a committed data_extraction.log once leaked the Yahoo client ID via
# yahoo_oauth's DEBUG logging of the full authorize URL. No log is ever safe
# to track.
*.log

# Raw data snapshots - raw Yahoo API responses carry league join passwords,
# invitation URLs, and account GUIDs. Only sanitized snapshots (produced by
# scripts/sanitize_snapshot.py, which nulls those fields) may be tracked.
data/current/*.json
!data/current/*_sanitized.json

# Pipeline state - checkpoints and local databases are machine-local
resume_*.txt
*.db

# Environment variables
.env
.env.local
.env.production

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python libraries
lib/
# But not web app lib directories
!web/src/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Note: web/ directory is tracked in git and has its own .gitignore
# that properly excludes build artifacts (node_modules, .svelte-kit, .env, etc.)
.vercel

# Per-run extraction snapshots: audit artifacts, uploaded by CI, never tracked
# (the retention policy keeps only the canonical baseline snapshot in-repo)
data/runs/
